# Expo public env vars are inlined into the JS bundle and shipped to devices.
# Only put values here that are safe to expose to clients (same trust level as
# NEXT_PUBLIC_* on the web). Server-only secrets do not belong here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only needed once Spotify auth is wired up.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
