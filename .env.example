NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — auth + journal storage (direct supabase-js queries, RLS-secured).
# Run supabase/migrations/0001_journal_entries.sql in your project once.
# Without these the app runs unauthenticated with localStorage persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NO NEXT_PUBLIC_ prefix — never expose to the browser). Required
# only for account deletion (회원 탈퇴): the DELETE /api/account route uses it to
# remove the user via the admin API. Copy it from Supabase → Project Settings →
# API → service_role. Leave blank to keep deletion disabled (route returns 503).
SUPABASE_SERVICE_ROLE_KEY=

# Music search uses the free iTunes Search API — no key or env vars needed.
