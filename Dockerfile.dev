# Dockerfile.dev — development image with hot reload (next dev).
#
# Unlike the production Dockerfile, this does NOT copy the source or run a
# build. The source is bind-mounted at runtime (see docker-compose.dev.yml) so
# edits on the host reload live. We only install dependencies here so they're
# baked into the image (and built for Linux, not the host OS).

FROM node:22-alpine
WORKDIR /app

# Install dependencies first for layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Dev-server settings:
#   WATCHPACK_POLLING / CHOKIDAR_USEPOLLING — make the file watcher poll, which
#   is the reliable way to pick up host edits across a Docker bind mount.
ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true \
    PORT=3000

EXPOSE 3000

# Bind to 0.0.0.0 so the server is reachable from the host.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
